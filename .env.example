POSTGRES_USER=de27four
POSTGRES_PASSWORD=de27four_pw
POSTGRES_DB=portfolio_analytics
DATABASE_URL=postgresql://de27four:de27four_pw@localhost:5432/portfolio_analytics

# Alpha Vantage API key, used by src/extract/market_data.py's extract_from_api
MARKET_API_KEY=

# Scheduler (src/orchestration/scheduler.py)
PIPELINE_SCHEDULE=0 18 * * 1-5
SCHEDULER_TIMEZONE=Africa/Johannesburg

# Comma-separated CSVs for run_pipeline (relative to repo root).
# Defaults to data/sample_prices.csv when unset.
CSV_SOURCES=data/sample_prices.csv

# Data source: csv (default) or api. The api source needs MARKET_API_KEY above.
DATA_SOURCE=csv
API_TICKERS=AAPL,MSFT
API_LOOKBACK_DAYS=30
API_PAUSE_SECONDS=12

# Data lake (Parquet + JSON manifests). Defaults to ./lake locally.
LAKE_ENABLED=true
# LAKE_DIR=/path/to/lake

# REST API: leave empty for an open local demo, or set a secret to require an
# X-API-Key header on every route except /health.
API_KEY=AN8G95ERRYW17NDH
